{
  "compilerOptions": {
    "module": "node20",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "es2024",
    "lib": ["es2024"],
    "noImplicitAny": false,
    "strict": false,
    "isolatedModules": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",
    "paths": {
      "@src/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "support"]
}
