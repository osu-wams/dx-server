{
  "name": "server",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "truncate -s 0 logs/localhost.log && cross-env NODE_ENV=localhost nodemon src/index.ts",
    "saml": "truncate -s 0 logs/development.log && cross-env NODE_ENV=development nodemon src/index.ts",
    "prebuild": "tsc --project . --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env NODE_ENV=test USE_MOCKS=0 NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --no-coverage --detectOpenHandles --forceExit",
    "test:coverage": "cross-env NODE_ENV=test USE_MOCKS=0 NODE_OPTIONS=\"--experimental-vm-modules --disable-warning=ExperimentalWarning\" jest --coverage --detectOpenHandles --forceExit",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.1",
    "codecov": "^3.8.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "msw": "^3.0.3",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-lambda": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@node-saml/passport-saml": "^5.1.1",
    "@osu-wams/grouper": "0.0.12",
    "@osu-wams/lib": "0.1.90",
    "config": "^5.0.1",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dynamodb-toolbox": "^2.11.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "express-winston": "^4.2.0",
    "google-auth-library": "^11.3.1",
    "googleapis": "^188.0.0",
    "jsonwebtoken": "^9.0.3",
    "logform": "^2.7.0",
    "passport": "^0.7.0",
    "passport-dev": "^1.0.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "redis": "^6.3.0",
    "rss-parser": "^3.13.0",
    "winston": "^3.19.0"
  }
}
